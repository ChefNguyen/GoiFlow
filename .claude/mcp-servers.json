{
  "note": "All servers are opt-in. Enable only when the current task needs them.",
  "servers": {
    "context7": {
      "enabled": true,
      "transport": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "--yes", "@upstash/context7-mcp"]
    },
    "playwright": {
      "enabled": false,
      "transport": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "--yes", "@playwright/mcp"]
    },
    "stitch": {
      "enabled": true,
      "transport": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "--yes", "stitch-mcp"],
      "env": {
        "GOOGLE_CLOUD_PROJECT": "goiflow"
      }
    },
    "gitnexus": {
      "enabled": true,
      "transport": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "--yes", "gitnexus@latest", "mcp"]
    }
  }
}
